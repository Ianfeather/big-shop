# Which TiDB instance the scripts in scripts/ talk to.
#
# Read by scripts/lib/tidb-env.sh, and therefore by every script in scripts/
# that talks to production: backup-prod.sh, check-charsets.sh, check-orphans.sh,
# migrate-prod.sh, probe-charset-conversion.sh and sync-from-prod.sh. NOT read
# by Next.js - @next/env only loads .env, .env.local and .env.<NODE_ENV>, so
# nothing here reaches the app.
#
# Tracked in git on purpose, like .env.development and .env.production. Nothing
# in this file is a secret: it names an instance, it does not open one. The
# password is never stored anywhere - each script prompts for it, silently, on
# every run. Do not add it here.

TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com

# The account a script connects as when it has asked for no narrower one, and
# the fallback for the two below.
#
# Root, because the scripts still defaulting to it need powers no narrower
# account has: backup-prod.sh takes a full logical backup, and
# probe-charset-conversion.sh deliberately attempts ALTERs. There is no single
# account those two could share with the ones that only read, which is why
# there are now three lines here instead of one.
TIDB_USER=3of82tmdiXMHzuo.root

# The account migrate-prod.sh connects as instead, and the reason this is a
# separate line rather than a different value above.
#
# Applying a migration needs far less than root (docs/ci-database-user.md), and
# the deploy has used this narrower account since #148. The script a person runs
# was still defaulting to TIDB_USER, so `./scripts/migrate-prod.sh --dry-run`
# rehearsed *root* unless you remembered to override it - which made it useless
# as a rehearsal, because the thing it was meant to prove is that the narrow
# grant is sufficient. Nothing said so; you simply got a pass that meant nothing.
#
# Overriding TIDB_USER explicitly still wins, for a one-off run as somebody else.
TIDB_MIGRATE_USER=3of82tmdiXMHzuo.gh_migrate

# The account the three read-only scripts connect as instead: check-charsets.sh,
# check-orphans.sh and sync-from-prod.sh. Same mechanism as TIDB_MIGRATE_USER
# above, through the same tidb_env_prefer_user function.
#
# **Commented out because the account does not exist yet.** Uncommenting is the
# switch, and it must not be flipped before someone has run the CREATE USER and
# GRANT in docs/reporting-database-user.md - otherwise these three scripts start
# failing to authenticate for everyone. Left commented, tidb_env_prefer_user
# falls back to TIDB_USER and they behave exactly as they always have, which is
# what makes this safe to merge ahead of the account being created.
#
# The grant is plain `SELECT ON bigshop.*` and nothing else - no LOCK TABLES, no
# PROCESS, no RELOAD. That was established by running these scripts' actual
# queries and mysqldump invocations under exactly that grant, not inferred: see
# docs/reporting-database-user.md, which also records why mysqldump needs
# --no-tablespaces to live within it.
#
# What it buys is smaller than the other two accounts and worth stating
# honestly: these scripts are run by a person, on an occasion, with the password
# typed at the prompt and stored nowhere, so there is no unattended credential
# for anyone to steal. It buys that a mistyped or mispasted statement in a
# reporting session cannot write, and that a laptop compromised mid-session
# yields a read.
# TIDB_READONLY_USER=3of82tmdiXMHzuo.reporting

# 4000 is TiDB Cloud's protocol port, not MySQL's usual 3306.
TIDB_PORT=4000
TIDB_DB=bigshop

# Only used by sync-from-prod.sh: which account's recipes to pull into local
# dev. Not necessarily 1 - migration 012 swapped accounts around, so confirm
# with `SELECT * FROM account_user;` in the TiDB console. Left unset, the
# script asks rather than guessing, because guessing wrong syncs somebody
# else's recipes.
ACCOUNT_ID=1
