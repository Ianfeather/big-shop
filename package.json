{
  "name": "big-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:full": "./scripts/dev-full.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate:api-types": "openapi-typescript docs/openapi.yaml -o types/api.d.ts",
    "package": "npm run lint && npm run typecheck && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e:stop && playwright test",
    "test:e2e:debug": "npm run test:e2e:stop && E2E_SLOWMO=800 playwright test --headed --workers=1",
    "test:e2e:stop": "./scripts/e2e-compose.sh down --remove-orphans --volumes >/dev/null 2>&1 || true",
    "test:evals": "./evals/run-evals.sh",
    "test:evals:shopping": "./evals/run-evals.sh shopping",
    "test:dave": "node evals/test-runner.js"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.22.0",
    "@grafana/faro-web-sdk": "^2.9.0",
    "@netlify/blobs": "8.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@tanstack/react-query": "^5.101.4",
    "express": "^4.17.2",
    "express-openid-connect": "^2.5.2",
    "formidable": "^3.5.2",
    "next": "^16.2.12",
    "node-html-parser": "^5.2.0",
    "openai": "^6.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "swagger-ui-react": "^5.32.9",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@grafana/faro-cli": "^0.11.0",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cors": "^2.8.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.0.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
