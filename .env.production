# Build-time defaults for a production build. Netlify's own environment
# variables override every one of these - @next/env never replaces a key already
# present in process.env - so treat this file as the fallback, and the Netlify UI
# as the control surface. Rollback is done there, not here (see
# docs/fly-migration-runbook.md).

# Relative, so the browser calls the API same-origin and Netlify's status = 200
# rewrite (netlify.toml) forwards it to the Fly machine. No CORS, and the Auth0
# bearer token behaves exactly as it did on the Lambda.
NEXT_PUBLIC_API_HOST=/api/bigshop

# Where server-side code - Netlify functions - reaches the API. Absolute,
# because the value above is meaningless inside a Node process, and direct to
# Fly because the alternative is us-east-2 -> Netlify's edge -> Frankfurt.
#
# Never give this a NEXT_PUBLIC_ prefix: Next.js inlines every NEXT_PUBLIC_*
# variable into the client bundle at build time, which would publish the
# unproxied origin to every visitor. See lib/api-host.ts.
API_HOST_INTERNAL=https://big-shop-api.fly.dev/api/bigshop

NEXT_PUBLIC_AUTH0_DOMAIN=dev-x-n37k6b.eu.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=HxkTOH3ZYxjbsgrVI4ii1CV2TQx7hk9G
NEXT_PUBLIC_AUTH0_AUDIENCE=https://big-shop-api
NEXT_PUBLIC_HOST=https://www.bigshop.life
