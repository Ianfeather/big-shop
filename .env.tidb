# Which TiDB instance the scripts in scripts/ talk to.
#
# Read by scripts/lib/tidb-env.sh, and therefore by backup-prod.sh,
# check-orphans.sh and sync-from-prod.sh. NOT read by Next.js - @next/env only
# loads .env, .env.local and .env.<NODE_ENV>, so nothing here reaches the app.
#
# Tracked in git on purpose, like .env.development and .env.production. Nothing
# in this file is a secret: it names an instance, it does not open one. The
# password is never stored anywhere - each script prompts for it, silently, on
# every run. Do not add it here.

TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com

# The account the interactive scripts connect as. Root, because between them
# they dump the whole database, alter charsets and read every schema - there is
# no narrower account that all of backup-prod.sh, check-charsets.sh and
# probe-charset-conversion.sh could share.
TIDB_USER=3of82tmdiXMHzuo.root

# The account migrate-prod.sh connects as instead, and the reason this is a
# separate line rather than a different value above.
#
# Applying a migration needs far less than root (docs/ci-database-user.md), and
# the deploy has used this narrower account since #148. The script a person runs
# was still defaulting to TIDB_USER, so `./scripts/migrate-prod.sh --dry-run`
# rehearsed *root* unless you remembered to override it - which made it useless
# as a rehearsal, because the thing it was meant to prove is that the narrow
# grant is sufficient. Nothing said so; you simply got a pass that meant nothing.
#
# Overriding TIDB_USER explicitly still wins, for a one-off run as somebody else.
TIDB_MIGRATE_USER=3of82tmdiXMHzuo.gh_migrate

# 4000 is TiDB Cloud's protocol port, not MySQL's usual 3306.
TIDB_PORT=4000
TIDB_DB=bigshop

# Only used by sync-from-prod.sh: which account's recipes to pull into local
# dev. Not necessarily 1 - migration 012 swapped accounts around, so confirm
# with `SELECT * FROM account_user;` in the TiDB console. Left unset, the
# script asks rather than guessing, because guessing wrong syncs somebody
# else's recipes.
ACCOUNT_ID=1
